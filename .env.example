# ─── Waka — variables d'environnement (copier en .env, ne JAMAIS committer .env) ───
# Voir apps/api/.env.example pour le détail complet des variables de l'API.

# URL interne de l'API utilisée par les proxys Next.js (web & admin)
API_URL=http://localhost:4000

# Base de données : vide => PGlite embarqué (apps/api/.pglite). Renseigner pour PostgreSQL réel.
# DATABASE_URL=postgres://waka:waka_dev_only@localhost:5432/waka
# TEST_DATABASE_URL=postgres://waka:waka_dev_only@localhost:5432/waka_test   # tests de concurrence réels

# Paiement : "mock" interdit en production (l'API refuse de démarrer).
PAYMENT_PROVIDER=mock
MOCK_PSP_WEBHOOK_SECRET=change-me-dev-only-secret
