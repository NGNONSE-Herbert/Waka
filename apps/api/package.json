{
  "name": "@waka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST Waka (NestJS + Drizzle/PGlite) — paiements MOCK uniquement",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/cli-migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/db/cli-seed.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@waka/contracts": "workspace:*",
    "@waka/domain": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^5.8.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
