# Waka API — variables d'environnement (copier en apps/api/.env). Ne JAMAIS committer de vrais secrets.

# Port HTTP de l'API (conventions : 4000).
PORT=4000
# development | test | production. En production : PAYMENT_PROVIDER=mock est refusé, /docs et /v1/dev désactivés, secrets obligatoires.
NODE_ENV=development
# Postgres réel (Docker/prod). Si absent : PGlite embarqué (Postgres WASM) dans PGLITE_DIR.
# DATABASE_URL=postgres://waka:waka@localhost:5432/waka
# Dossier de données PGlite, relatif à apps/api (ou chemin absolu, ou memory:// pour une base volatile).
PGLITE_DIR=.pglite
# Prestataire de paiement : mock (dev uniquement) | mtn_momo | orange_money (adaptateurs bloqués tant que le contrat PSP n'est pas signé).
PAYMENT_PROVIDER=mock
# Secret HMAC-SHA256 des webhooks du PSP simulé (en-tête x-mock-signature: t=<unix>,v1=<hex>). Valeur de dev générée avec avertissement si absent.
MOCK_PSP_WEBHOOK_SECRET=change-me-dev-only-mock-psp-secret
# Référence marchand attendue sur chaque encaissement (vérifiée avant confirmation).
MOCK_PSP_MERCHANT_REF=WAKA-MOCK-MERCHANT
# Secret applicatif (≥ 32 caractères) : chiffrement AES-GCM du PIN d'embarquement et des secrets TOTP, HMAC des OTP.
APP_SECRET=change-me-dev-only-app-secret-at-least-32-chars
# Durée du hold de places avant paiement (secondes, défaut 600 = 10 min).
HOLD_TTL_SECONDS=600
# Durée de session utilisateur (heures). La session staff est fixée par ADMIN_SESSION_TTL_HOURS (défaut 8).
SESSION_TTL_HOURS=72
ADMIN_SESSION_TTL_HOURS=8
# Origines autorisées (CORS avec cookies). Le navigateur passe normalement par le proxy même-origine de Next.
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# Délai avant que le PSP simulé confirme automatiquement un versement/remboursement (webhook), en ms.
MOCK_PAYOUT_DELAY_MS=3000
# Travailleur outbox en processus (true/false) et période de sondage (ms).
OUTBOX_WORKER=true
OUTBOX_POLL_MS=1000
# debug | info | warn | error | silent — journaux JSON (téléphones masqués, OTP visible en dev uniquement).
LOG_LEVEL=info
# Seed de démonstration automatique au premier démarrage si la base est vide (jamais en production).
SEED_ON_EMPTY=true
# Limites OTP : démarrages autorisés par 10 min, par numéro et par IP.
OTP_MAX_PER_PHONE=3
OTP_MAX_PER_IP=3
# Réglage Express « trust proxy » (le proxy Next est local).
TRUST_PROXY=loopback
