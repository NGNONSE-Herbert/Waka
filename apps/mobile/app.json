{
  "expo": {
    "name": "Waka",
    "slug": "waka",
    "scheme": "waka",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F7EE",
    "android": {
      "package": "cm.waka.app.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
